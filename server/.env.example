# Local test DB. To go live, swap in your Atlas cluster string — nothing else changes:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ambodo
PORT=4000
HOST=127.0.0.1

# Ambodo Family billing (RevenueCat). Without a key, purchases run in test mode (no charge) outside production.
# REVENUECAT_SECRET_KEY=sk_...
# BILLING_DEV=false

# Store pages (/privacy, /terms, /support, /delete-account) show these. Required when NODE_ENV=production.
# SUPPORT_EMAIL=support@yourdomain.com
# LEGAL_NAME=Your Name or Company Ltd
